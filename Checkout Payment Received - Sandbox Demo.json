      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Checkout Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -180,
        380
      ],
      "webhookId": "c8f1d2a3-4b5c-4d6e-8f90-a1b2c3d4e5f6",
      "notes": "Raw Body ON so the signature can be verified. Respond immediately: Checkout only needs a 200."
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// n8n Cloud blocks $env, so the key lives here.\n// Sandbox only. For production use an n8n credential, not a literal.\nconst SIGNATURE_KEY = 'e6a6f771-fa63-4aaf-aefd-64e3e4635134';\n\n// Verified 19-Sep-2026: header is 'cko-signature', signatureValid = true.\nconst ENFORCE = true;\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const headers = item.json.headers || {};\n\n  const b64 = item.binary?.data?.data;\n  if (!b64) throw new Error('No raw body. Turn on Options > Raw Body in the Webhook node.');\n  const raw = Buffer.from(b64, 'base64');\n\n  const received = headers['cko-signature'] || headers['Cko-Signature'] || '';\n  const expected = crypto.createHmac('sha256', SIGNATURE_KEY).update(raw).digest('hex');\n\n  const valid = received.length > 0 &&\n    received.length === expected.length &&\n    crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\n  if (ENFORCE && !valid) {\n    throw new Error('Invalid Checkout signature. Received: ' + received);\n  }\n\n  const body = JSON.parse(raw.toString('utf8'));\n  const d = body.data || body;\n\n  out.push({ json: {\n    signatureValid: valid,\n    signatureReceived: received,\n    signatureExpected: expected,\n    headerNames: Object.keys(headers),\n    eventType: body.type || '',\n    eventId: body.id || '',\n    paymentId: d.id || '',\n    reference: d.reference || '',\n    amountMinor: d.amount ?? null,\n    amount: d.amount != null ? Number(d.amount) / 100 : null,\n    currency: d.currency || '',\n    metadata: d.metadata || {},\n    importKey: (d.metadata && d.metadata.importKey) || d.reference || '',\n    paidAt: d.processed_on || body.created_on || new Date().toISOString(),\n    rawBody: body\n  }});\n}\n\nreturn out;"
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        380
      ],
      "notes": "HMAC-SHA256 over the RAW body. Key is inline because n8n Cloud blocks $env. Flip ENFORCE to true after the first execution confirms the header name."
    },
